<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>

		<TargetFramework>net10.0</TargetFramework>

		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- publish -->
		<PublishSingleFile>true</PublishSingleFile>
		<SelfContained>true</SelfContained>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>

		<!-- optimization -->
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
		<PublishReadyToRun>true</PublishReadyToRun>

		<!-- docs -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>

		<!-- cleanup -->
		<InvariantGlobalization>false</InvariantGlobalization>

		<!-- debug -->
		<DebugType>none</DebugType>
		<DebugSymbols>false</DebugSymbols>

		<!-- metadata -->
		<AssemblyName>DemoETL</AssemblyName>
		<RootNamespace>DemoETL</RootNamespace>

	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="ClosedXML" Version="0.105.0" />
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.7" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.7" />
		<PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.7" />
		<PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.7" />
	</ItemGroup>

	<ItemGroup>

		<None Update="Application\Configuration\documents.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<TargetPath>Configs\documents.json</TargetPath>
		</None>

		<None Update="Extraction\Configs\*.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<TargetPath>Configs\%(Filename)%(Extension)</TargetPath>
		</None>

		<None Update="Transformation\Xslt\*.xslt">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<TargetPath>Xslt\%(Filename)%(Extension)</TargetPath>
		</None>

		<None Update="Validation\Schemas\*.xsd">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<TargetPath>Schemas\%(Filename)%(Extension)</TargetPath>
		</None>

		<!-- example file -->
		<None Update="Examples\example.xlsx">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>

	</ItemGroup>

</Project>